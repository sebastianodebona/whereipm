### * Setup

### ** Stores root folder
TOP_DIR=$(shell git rev-parse --show-toplevel)

### ** Colours
RED = "\\033[31m"
YELLOW = "\\033[33m"
GREEN = "\\033[92m"
NC = "\\033[0m"
RV = "\\033[7m"
SB = "\\033[5m"

### * Rules

### ** help

# http://swcarpentry.github.io/make-novice/08-self-doc/
# https://stackoverflow.com/questions/19129485/in-linux-is-there-a-way-to-align-text-on-a-delimiter
.PHONY: help
help: Makefile
	@printf "\n"
	@printf "$(GREEN)*** Please use 'make <target>' where <target> is one of: ***$(NC)\n"
	@printf "\n"
	@sed -n 's/^## /    /p' $< | column -t -s ":"
	@printf "\n"

### ** data

## data : populate the data/ folder from the data-raw/ folder
.PHONY: data
data: data/ipmdata.rda
	@printf "\n"
	@printf "$(GREEN)*** Building package data files ***$(NC)\n"
	@printf "\n"

data/ipmdata.rda: data-raw/prep-ipmdata.Rmd data-raw/Pedigree.csv data-raw/GuppyData_LL.csv data-raw/reach_key.txt
	@mkdir -p data/
	@cd data-raw/; R -e "rmarkdown::render('prep-ipmdata.Rmd')"

### ** document

## document : generate documentation with roxygen
.PHONY: document
document:
	@printf "\n"
	@printf "$(GREEN)*** Generating documentation ***$(NC)\n"
	@printf "\n"
	Rscript -e 'devtools::document()'
	
### ** pkgdown

## pkgdown : build the package website using pkgdown (also renders the vignettes)
.PHONY: pkgdown
pkgdown: install
	@printf "\n"
	@printf "$(GREEN)*** Building package website with pkgdown ***$(NC)\n"
	@printf "\n"
	@Rscript -e 'pkgdown::build_site()'
	
### ** install	
	
## install : install the package (also runs data and document)
.PHONY: install
install: data document
	@printf "\n"
	@printf "$(GREEN)*** Installing package ***$(NC)\n"
	@printf "\n"
	Rscript -e 'devtools::install(upgrade_dependencies = FALSE)'
	@printf "\n"

### ** clean

## clean : delete all files and folders generated during building process
.PHONY: clean
clean: clean-data clean-man clean-docs clean-vignettes
	@printf "\n"
	@printf "$(GREEN)*** Cleaned generated files and folders ***$(NC)\n"
	@printf "\n"

### ** clean-data

## clean-data : delete all package data files built from prep_data/
.PHONY: clean-data
clean-data:
	rm -f data/*
	rm -f inst/extdata/*
	cd data-raw/; rm -f *.html

### ** clean-man

## clean-man : delete documentation generated by Roxygen
.PHONY: clean-man
clean-man:
	rm -f man/*

### ** clean-docs

## clean-docs : delete documentation generated by pkgdown
.PHONY: clean-docs
clean-docs:
	rm -fr docs/*

### ** clean-vignettes

## clean-vignettes : remove html, rda and rds files from the vignettes/ folder
.PHONY: clean-vignettes
clean-vignettes:
	@printf "\n"
	@printf "$(GREEN)*** Cleaning vignettes/ folder ***$(NC)\n"
	@printf "\n"
	rm -f vignettes/*.html

### ** uninstall
	
## uninstall : uninstall the package
.PHONY: uninstall
uninstall:
	@printf "\n"
	@printf "$(RED)*** Uninstalling package ***$(NC)\n"
	@printf "\n"
	Rscript -e "tryCatch(remove.packages('whereipm'), error = function(e) {})"
	@printf "\n"

### ** test

## test : run test on package
.PHONY: test
test:
	@printf "\n"
	@printf "$(GREEN)$(FR)*** Running test ***$(NC)\n"
	@printf "\n"
	Rscript -e "devtools::test()"
	@printf "\n"
	
## coverage : determine test coverage
.PHONY: coverage
coverage:
	@printf "\n"
	@printf "$(GREEN)*** Determining test coverage ***$(NC)\n"
	@printf "\n"
	@mkdir -p docs/coverage/
	@Rscript -e "library(covr); cov = package_coverage(); report(cov, \"$(TOP_DIR)/docs/coverage/coverage.html\"); print(paste(\"Coverage_percent: --\", round(percent_coverage(cov), 2), \"--\"))"
	
## rehearse : unistall package, clean, install again and run test
.PHONY: rehearse
rehearse: uninstall clean install test
	
